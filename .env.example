# Copy to .env and fill in (never commit .env).

# --- OpenDental MySQL -------------------------------------------------------
OD_DB_HOST=127.0.0.1
OD_DB_PORT=3306
OD_DB_USER=root
OD_DB_PASSWORD=
OD_DB_NAME=opendental_123
# OD_RECALL_TYPE_NUM=1          # ProphyRecall
# OD_PROV_NUM=1                 # Default Provider
# OD_OPERATORY_NUM=5            # Hygiene Op 1
# OD_ROLL_DUE_DATE_ON_COMPLETE=false   # keep false: Adit "Completed" needs due date + appointment in the same month

# --- Adit (same login as Reminder-Sanity-Automation) -------------------------
RECALL_CHECK_ENV=Live
ADIT_USERNAME=
ADIT_PASSWORD=
ADIT_X_AUTH_KEY=
ADIT_X_AUTH_TOKEN=
# ADIT_ORGANIZATION_ID=
# ADIT_LOCATION_ID=

# --- Engage -> Reports -> Automated Recall (default: {engmodapi}engage/report/recall/get) ---
# ADIT_RECALL_REPORT_URL=

# --- Waiting for Adit's sync ---------------------------------------------------
# Wait after the last OpenDental write before the first Adit check (Adit sync ~5 min)
RECALL_CHECK_SYNC_WAIT_SECONDS=300
RECALL_CHECK_POLL_INTERVAL_SECONDS=60
RECALL_CHECK_POLL_TIMEOUT_SECONDS=1800

# RECALL_CHECK_CLEANUP=true           # remove the run's appointments afterwards
# RECALL_CHECK_CLEANUP_RECALLS=false  # keep recalls after the run (true = delete/restore them)
LOG_LEVEL=INFO

# --- Publishing: PDF -> Google Drive -> Google Chat (skipped when unset) ------
# One or more Chat incoming webhooks, comma-separated - the card is posted to each.
GCHAT_WEBHOOK_URL=
GDRIVE_SERVICE_ACCOUNT_FILE=
GDRIVE_FOLDER_ID=
GDRIVE_SHARE_DOMAIN=
# GDRIVE_REPORT_FOLDER_NAME=Recall Report   # Drive: <folder>/<YYYY-MM Month>/<report>.pdf
# PDF_BROWSER_PATH=
